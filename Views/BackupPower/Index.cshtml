@{ ViewData["Title"] = "Backup power planner"; }
@section Styles { <link rel="stylesheet" href="~/css/backup-power.css" asp-append-version="true" /> }
<section class="backup-intro">
    <p class="backup-eyebrow">For market and building managers</p>
    <h1>Backup power planner</h1>
    <p>Plan which shops receive generator power during outages. Protect mandatory loads, respect the daily diesel budget and limit consecutive dark hours. This is a planning aid, not automatic generator control.</p>
</section>
<div class="backup-workbench">
    <section class="card backup-controls" aria-labelledby="backup-input-heading">
        <h2 id="backup-input-heading">1. Review your scenario</h2>
        <p>Set your generator limits, build the timeline, and enter the shops that need power.</p>
        <button id="backup-example" type="button">Reset to worked example</button>
        <form id="backup-input">
            <fieldset>
                <legend>Generator and fuel</legend>
                <div class="backup-fields">
                    <label>Capacity (kW)<input id="backup-capacity" type="number" min="1" max="1000000" required /></label>
                    <label>Fuel budget (L)<input id="backup-budget" type="number" min="0" max="1000000" step="0.01" required /></label>
                    <label>Maximum time without power (minutes)<input id="backup-dark-limit" type="number" min="0" max="1440" required /></label>
                </div>
                <p>Fuel rates are applied to the combined generator load and prorated by slot duration. The highest band must match generator capacity.</p>
                <div id="backup-bands"></div>
                <button id="backup-add-band" type="button">Add fuel band</button>
            </fieldset>
            <fieldset>
                <legend>Power timeline</legend>
                <p>Slots run consecutively in Asia/Dhaka time. Add up to 24 slots and plan through midnight.</p>
                <label class="backup-start">Start time<input id="backup-start" type="time" value="10:00" required /></label>
                <div id="backup-slots"></div>
                <button id="backup-add-slot" type="button">Add slot</button>
            </fieldset>
            <fieldset>
                <legend>Shops and priorities</legend>
                <p>Mandatory shops receive power during every outage. Give each shop a priority value for each slot.</p>
                <div id="backup-shops"></div>
                <button id="backup-add-shop" type="button">Add shop</button>
            </fieldset>
            <div class="backup-actions"><button id="backup-run" type="submit">Generate roster</button></div>
        </form>
        <p id="backup-status" role="status" aria-live="polite">Review the worked example or edit the fields to build your own plan.</p>
        <ul id="backup-errors" role="alert"></ul>
        <noscript><p>Enable JavaScript to use the planner.</p></noscript>
    </section>
    <aside class="card backup-import" aria-labelledby="backup-import-heading">
        <h2 id="backup-import-heading">Optional: use a published outage plan</h2>
        <p>DPDC/DESCO or utility officials publish the zone schedule. The market manager supplies the generator, fuel and shop requirements. Import replaces your timeline with the published hourly slots. Your generator and shops stay in the form.</p>
        @if (User.IsInRole("Resident") || Nagorik.Api.Authorization.UtilityScheduleAccess.IsOfficial(User))
        {
            <label for="backup-zone">Zone</label><select id="backup-zone"><option value="">Loading zones…</option></select>
            <label for="backup-date">Plan date (Asia/Dhaka)</label><input id="backup-date" type="date" />
            <button id="backup-import" type="button">Import published outage hours</button>
            <p id="backup-source" role="status">Select a zone and a date in the current seven-day view.</p>
        }
        else
        {
            <p><a href="/login.html?returnUrl=%2Fbackup-power">Sign in as a resident or electricity official</a> to import published schedules. Manual planning remains available without an account.</p>
        }
        <h3>Before operating the generator</h3>
        <p>Have the responsible operator review actual loads, safety limits, fuel availability and the published roster. Values and mandatory designations are supplied by the manager, not measured or certified by Nagorik.</p>
        <p>Re-import and regenerate if the outage schedule changes. A saved result is a snapshot, not a live update.</p>
    </aside>
</div>
<section id="backup-results" hidden aria-labelledby="backup-results-heading">
    <h2 id="backup-results-heading">2. Review the roster</h2>
    <p id="backup-result-message"></p>
    <div id="backup-summary" class="backup-summary"></div>
    <div class="backup-table-wrap" role="region" tabindex="0" aria-label="Power roster">
        <table id="backup-board"><caption>Asia/Dhaka. Grid = grid supply; On = generator supply; Dark = no scheduled power. Mandatory shops are marked.</caption><thead></thead><tbody></tbody><tfoot></tfoot></table>
    </div>
    <h3 class="backup-reason-title">Why a shop is dark</h3><ul id="backup-reasons"></ul>
    <p class="backup-print-note">Planning snapshot. Verify current outage hours and physical generator conditions before use.</p>
    <div class="backup-actions"><button id="backup-print" type="button">Print A4 roster</button></div>
</section>
@section Scripts { <script src="~/js/backup-power.js" asp-append-version="true"></script> }
