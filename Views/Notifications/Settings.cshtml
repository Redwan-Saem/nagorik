<h1>Area risk alerts</h1>
@Html.AntiForgeryToken()
<p>Enable area-risk alerts, choose saved areas in <a href="/resident/areas">My areas</a>, and enable push on this device.</p>

<div class="form-check form-switch mb-3">
    <input class="form-check-input"
           type="checkbox"
           id="notifications-enabled" />

    <label class="form-check-label"
           for="notifications-enabled">
        Enable area-risk alerts
    </label>
</div>

<button id="enable-push" type="button">Enable push on this device</button>
<p id="push-status" role="status" aria-live="polite"></p>

<button id="save-settings"
        class="btn btn-primary">
    Save
</button>

<div id="settings-status"
     class="mt-2"
     role="status">
</div>

@section Scripts {
    <script src="~/js/push-subscribe.js"></script>
    <script src="~/js/notification-settings.js"></script>
}
