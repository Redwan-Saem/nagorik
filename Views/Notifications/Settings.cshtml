<h2>Waterlogging alerts</h2>

<div class="form-check form-switch mb-3">
    <input class="form-check-input"
           type="checkbox"
           id="notifications-enabled" />

    <label class="form-check-label"
           for="notifications-enabled">
        Send me alerts
    </label>
</div>

<div id="zone-list" class="mb-3"></div>

<button id="save-settings"
        class="btn btn-primary">
    Save
</button>

<div id="settings-status"
     class="mt-2"
     role="status">
</div>

@section Scripts {
    <script src="~/js/push-subscribe.js"></script>
    <script src="~/js/notification-settings.js"></script>
}