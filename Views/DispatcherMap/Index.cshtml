@{
    ViewData["Title"] = "Dispatcher risk map";
}
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dispatcher-map.css" asp-append-version="true" />
}
<section id="dispatcher-risk-map" aria-labelledby="map-heading">
    <h1 id="map-heading">Dispatcher risk map</h1>
    <p>Inspect zone boundaries and stored waterlogging risk.</p>
    <p class="alert alert-warn">Development zones labelled “sample boundary” use synthetic boundaries and sample risk levels. They are not live forecasts or official geographic boundaries.</p>
    <div class="map-toolbar">
        <button type="button" id="map-refresh">Refresh zones</button>
    </div>
    <p id="map-status" role="status" aria-live="polite">Loading risk zones…</p>
    <p id="map-error" class="alert alert-bad" role="alert" hidden></p>
    <a id="map-login" href="/login.html?returnUrl=%2Fdispatcher%2Fmap" hidden>Log in again</a>
    <p id="map-tile-status" class="muted" role="status"></p>
    <div id="risk-zone-map" tabindex="0" aria-label="Interactive Dhaka risk-zone map"></div>
    <noscript><p>Enable JavaScript to display the map. Zone data is available to dispatchers at /api/map/risk-zones.</p></noscript>
</section>
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/dispatcher-map.js" asp-append-version="true"></script>
}
