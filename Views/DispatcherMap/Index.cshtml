@{
    ViewData["Title"] = "Dispatcher risk map";
}
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dispatcher-map.css" asp-append-version="true" />
}
<section id="dispatcher-risk-map" aria-labelledby="map-heading">
    <h1 id="map-heading">Dispatcher risk map</h1>
    @Html.AntiForgeryToken()
    <p>Inspect zone boundaries and stored waterlogging risk.</p>
    <p><a href="/dispatcher/flagged-drainage">Open flagged drainage panel and assign an inspection crew</a></p>
    <p class="alert alert-warn">Development zones labelled “sample boundary” use synthetic boundaries, not official geography. Computed levels use an uncalibrated rule baseline. Unknown means required data is missing or stale. Check the evaluation and rainfall timestamps in each popup.</p>
    <div class="map-toolbar">
        <button type="button" id="map-refresh">Refresh zones</button>
        <label><input type="checkbox" id="map-zone-toggle" checked /> Show risk zones</label>
        <label><input type="checkbox" id="map-drainage-toggle" checked /> Show drainage points</label>
        <label><input type="checkbox" id="map-reports-toggle" checked /> Show reports</label>
        <label><input type="checkbox" id="map-crews-toggle" checked /> Show crew locations</label>
    </div>
    <ul id="map-legend" class="map-legend" aria-label="Zone risk legend">
        <li><span class="risk-swatch risk-unknown" aria-hidden="true"></span>Unknown</li>
        <li><span class="risk-swatch risk-low" aria-hidden="true"></span>Low</li>
        <li><span class="risk-swatch risk-medium" aria-hidden="true"></span>Medium</li>
        <li><span class="risk-swatch risk-high" aria-hidden="true"></span>High</li>
        <li><span class="risk-swatch risk-severe" aria-hidden="true"></span>Severe</li>
    </ul>
    <p id="map-status" role="status" aria-live="polite">Loading risk zones…</p>
    <p id="map-error" class="alert alert-bad" role="alert" hidden></p>
    <a id="map-login" href="/login.html?returnUrl=%2Fdispatcher%2Fmap" hidden>Log in again</a>
    <p id="map-tile-status" class="muted" role="status"></p>
    <p class="muted">Drainage icons: ✓ Clear · ! Blocked · ? Unknown</p>
    <p id="map-drainage-status" role="status" aria-live="polite"></p>
    <p id="map-drainage-error" class="alert alert-bad" role="alert" hidden></p>
    <p id="map-drainage-action" role="status" aria-live="polite"></p>
    <p id="map-drainage-action-error" class="alert alert-bad" role="alert" hidden></p>
    <p id="map-reports-status" role="status" aria-live="polite"></p>
    <p id="map-reports-error" class="alert alert-bad" role="alert" hidden></p>
    <p id="map-crews-status" role="status" aria-live="polite"></p>
    <p class="muted">Crews: F = free, B = busy, ? = stale (older than 15 minutes). GPS is shared only with successful task updates.</p>
    <div id="risk-zone-map" tabindex="0" aria-label="Interactive Dhaka risk-zone map"></div>
    <section class="map-zone-details" aria-labelledby="zone-detail-heading">
        <h2 id="zone-detail-heading">Selected zone</h2>
        <p id="map-zone-details" role="status" aria-live="polite">Select a zone on the map to inspect its risk and last computation time.</p>
    </section>
    <noscript><p>Enable JavaScript to display the map. Zone data is available to dispatchers at /api/map/risk-zones.</p></noscript>
</section>
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/dispatcher-map-layers.js" asp-append-version="true"></script>
    <script src="~/js/dispatcher-crews.js" asp-append-version="true"></script>
    <script src="~/js/dispatcher-map.js" asp-append-version="true"></script>
}
