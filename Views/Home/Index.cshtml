@model Nagorik.Api.Models.DashboardViewModel
@{ViewData["Title"]="Your city, within reach";}
@section Styles {<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />}
<section class="dashboard-hero">
    <p class="dashboard-eyebrow">NAGORIK · CITY SERVICES</p>
    <h1>Your city,<br />within reach.</h1>
    <p>Report an issue, check published services, and plan a journey from one place.</p>
    @if(Model.Authenticated){<p class="dashboard-session">Your workspace · @Model.Role</p>}
    else {<div class="dashboard-actions"><a class="btn" href="/login.html?returnUrl=%2F">Sign in to your workspace</a><a href="/register.html">Create a resident account</a></div>}
</section>
@if(Model.Work.Count>0)
{
    <section aria-labelledby="workspace-heading"><div class="dashboard-heading"><h2 id="workspace-heading">Your workspace</h2><p>Actions available for your signed-in role.</p></div><div class="dashboard-grid" id="dashboard-work">
    @foreach(var card in Model.Work){<a class="dashboard-card" href="@card.Href"><h3>@card.Title <span aria-hidden="true">↗</span></h3><p>@card.Description</p><span class="dashboard-open">Open workspace →</span></a>}
    </div></section>
}
<section aria-labelledby="explore-heading"><div class="dashboard-heading"><h2 id="explore-heading">Explore your area</h2><p>Public information you can check before signing in.</p></div><div class="dashboard-grid" id="dashboard-public">
@foreach(var card in Model.Public){<a class="dashboard-card" href="@card.Href"><h3>@card.Title <span aria-hidden="true">↗</span></h3><p>@card.Description</p><span class="dashboard-open">Explore →</span></a>}
</div></section>
<aside class="dashboard-note"><h2>Check the source. Check the time.</h2><p>Each feature shows its available data and limitations. Published plans can be unknown, community observations expire, and regional estimates differ from local measurements. Demonstration data is labelled; the risk map uses an uncalibrated rule baseline.</p></aside>
