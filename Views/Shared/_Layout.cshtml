<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Nagorik</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
        <span class="brand">Nagorik</span>
        <nav>
            <ul>
                <li><a href="/map">Area risk map</a></li>
                <li><a href="/transport">Transport routes</a></li>
                <li><a href="/transport/occupancy">Bus occupancy</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Sos" asp-action="Index">SOS assistance</a>
                    </li>
                }
                @if (User.IsInRole("Resident"))
                {
                    <li><a href="/resident/areas">My areas</a></li>
                    <li><a href="/resident/loadshedding">Loadshedding schedule</a></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reports" asp-action="UtilityCreate">Report utility anomaly</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Reports"
                           asp-action="Create">
                            Report an Issue
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Reports"
                           asp-action="Mine">
                            My Reports
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Notifications"
                           asp-action="Settings">
                            Alerts
                        </a>
                    </li>
                }

                @if (Nagorik.Api.Authorization.OfficialAccess.IsOfficial(User))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="OfficialReports" asp-action="Index">City reports</a>
                    </li>
                }

                @if (Nagorik.Api.Authorization.UtilityScheduleAccess.IsOfficial(User))
                {
                    <li><a href="/official/loadshedding">Loadshedding schedules</a></li>
                }

                @if (User.IsInRole("Dispatcher"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DispatcherMap" asp-action="Index">Dispatcher risk map</a>
                        <a class="nav-link" href="/dispatcher/flagged-drainage">Flagged drainage</a>
                        <a class="nav-link" href="/dispatcher/report-verification">Verify public markers</a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li><a href="/admin/risk-thresholds">Risk thresholds</a></li>
                    <li><a href="/admin/risk-alert-deliveries">Risk alert delivery diagnostics</a></li>
                }

                @if (User.IsInRole("Crew"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="CrewTasks" asp-action="Index">My Tasks</a>
                    </li>
                }

                @if (User.IsInRole("Crew") || User.IsInRole("Dispatcher"))
                {
                    <li class="nav-item">
                        <button id="enable-push"
                                class="btn btn-sm btn-outline-light">
                            Enable notifications
                        </button>
                        <span id="push-status" role="status" aria-live="polite"></span>
                    </li>
                }
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    @if (User.IsInRole("Crew") || User.IsInRole("Dispatcher"))
    {
        <script src="~/js/push-subscribe.js"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
