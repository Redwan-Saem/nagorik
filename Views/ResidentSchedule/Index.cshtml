@{ ViewData["Title"] = "Loadshedding schedule"; }
<section id="resident-schedule">
<h1>Loadshedding schedule</h1>
<p>View the published plan for your chosen zone. All dates and times use Asia/Dhaka. A published plan is not confirmation of an actual power outage.</p>
<p><label for="schedule-zone">Zone</label> <select id="schedule-zone" disabled><option value="">Loading zones…</option></select>
<button type="button" id="schedule-refresh" disabled>Refresh schedule</button></p>
<p><button type="button" id="schedule-locate" disabled>Use my location to find my zone</button>
<button type="button" id="schedule-location-clear">Clear location request</button></p>
<p>GPS is optional. Matching happens in your browser; your coordinates are not uploaded. You can change the zone manually.</p>
<p id="schedule-location-status" role="status" aria-live="polite"></p>
<p id="resident-schedule-status" role="status" aria-live="polite">Loading available zones…</p>
<p id="schedule-cache-notice" role="status" hidden></p>
<p><a id="schedule-sign-in" href="/login.html?returnUrl=%2Fresident%2Floadshedding" hidden>Sign in again</a></p>
<h2 id="schedule-zone-name">Choose a zone</h2>
<p id="schedule-publication-summary"></p><p id="schedule-last-updated"></p>
<h2>Next outage</h2><p id="schedule-next-outage">Choose a zone to see its published plan.</p>
<h2>Seven-day plan</h2><ol id="schedule-days"></ol>
</section>
<noscript>JavaScript is required to load current schedules. An offline copy is available only after you have loaded a plan while connected.</noscript>
@section Styles { <link rel="stylesheet" href="~/css/loadshedding.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/zone-locator.js" asp-append-version="true"></script>
    <script src="~/js/resident-schedule-location.js" asp-append-version="true"></script>
    <script src="~/js/resident-schedule-transport.js" asp-append-version="true"></script>
    <script src="~/js/resident-loadshedding.js" asp-append-version="true"></script>
}
