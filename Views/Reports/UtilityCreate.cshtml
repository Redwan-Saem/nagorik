@model Nagorik.Api.Models.UtilityAnomalyFormViewModel
@using Nagorik.Api.Models
@{
    ViewData["Title"] = "Report a utility anomaly";
}
@section Styles {
    <link rel="stylesheet" href="~/css/utility-anomaly-form.css" asp-append-version="true" />
}
<section class="utility-report" aria-labelledby="utility-heading">
    <h1 id="utility-heading">Report a utility anomaly</h1>
    <p>Tell us about a gas, water or electrical problem in your area. Fields marked * are required.</p>
    <form id="utility-form" class="card" action="/api/reports/utility-anomalies" method="post" enctype="multipart/form-data" novalidate
          data-high-risk-types="@string.Join(',', Enum.GetValues<AnomalyType>().Where(UtilityAnomalyRules.IsHighRisk))">
        <fieldset id="utility-fields">
            <legend>Problem details</legend>
            <label for="utility-AnomalyType">Problem type *</label>
            <select id="utility-AnomalyType" name="AnomalyType" required aria-describedby="utility-AnomalyType-error">
                <option value="">Choose a problem type</option>
                @foreach (var type in Enum.GetValues<AnomalyType>())
                {
                    <option value="@type">@UtilityAnomalyFormViewModel.TypeLabel(type)</option>
                }
            </select>
            <p id="utility-AnomalyType-error" class="error" hidden></p>
            <div id="utility-safety" class="alert alert-warn" role="status" hidden>
                <strong>High-risk hazard</strong>
                <p>Keep a safe distance. Do not approach the hazard to take photos or try to repair it. If you need immediate assistance, <a asp-controller="Sos" asp-action="Index">request SOS assistance</a>.</p>
            </div>
            <label for="utility-AreaId">Area *</label>
            <select id="utility-AreaId" name="AreaId" required aria-describedby="utility-AreaId-error">
                <option value="">Choose an area</option>
                @foreach (var area in Model.Areas)
                {
                    <option value="@area.Id">@area.Name</option>
                }
            </select>
            <p id="utility-AreaId-error" class="error" hidden></p>
            <label for="utility-AddressText">Address or nearby landmark *</label>
            <input id="utility-AddressText" name="AddressText" type="text" maxlength="300" required aria-describedby="utility-address-hint utility-AddressText-error" />
            <p id="utility-address-hint" class="hint">Include a street, building or landmark. An address is required even when using GPS.</p>
            <p id="utility-AddressText-error" class="error" hidden></p>
            <div class="utility-actions">
                <button type="button" id="utility-use-gps" class="btn btn-ghost">Add my GPS location (optional)</button>
                <button type="button" id="utility-clear-gps" class="btn btn-ghost" hidden>Use address only</button>
            </div>
            <p id="utility-gps-status" class="hint" role="status" aria-live="polite">GPS is optional. You can use an address only.</p>
            <p id="utility-Latitude-error" class="error" hidden></p>
            <p id="utility-Longitude-error" class="error" hidden></p>
            <label for="utility-Description">Description *</label>
            <textarea id="utility-Description" name="Description" rows="4" minlength="10" maxlength="1000" required aria-describedby="utility-description-hint utility-count utility-Description-error"></textarea>
            <p id="utility-description-hint" class="hint">Use 10–1000 characters to describe the problem and where it is.</p>
            <p id="utility-count" class="hint">0 / 1000 characters</p>
            <p id="utility-Description-error" class="error" hidden></p>
            <label for="utility-Photos">Photos *</label>
            <input id="utility-Photos" name="Photos" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple required aria-describedby="utility-photo-hint utility-Photos-error" />
            <p id="utility-photo-hint" class="hint">Choose 1–3 JPG or PNG photos, up to 5 MiB each. Only use photos you can obtain safely. Choosing files again replaces the selection.</p>
            <p id="utility-Photos-error" class="error" hidden></p>
            <div id="utility-previews" aria-label="Selected photo previews"></div>
            <button type="button" id="utility-clear-photos" class="btn btn-ghost" hidden>Remove all photos</button>
        </fieldset>
        <p id="utility-error" class="error" role="alert" tabindex="-1" hidden></p>
        <p id="utility-status" role="status" aria-live="polite"></p>
        <a id="utility-check-mine" asp-controller="Reports" asp-action="Mine" hidden>Check My Reports</a>
        <a id="utility-login" href="/login.html?returnUrl=%2Freports%2Futility-anomalies%2Fcreate" hidden>Sign in again</a>
        <button id="utility-submit" type="submit" disabled>Submit utility report</button>
        <noscript><p>Enable JavaScript to validate photos and submit this report.</p></noscript>
    </form>
</section>
@section Scripts {
    <script src="~/js/utility-anomaly-form.js" asp-append-version="true"></script>
}
